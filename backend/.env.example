# El Kaptin backend — environment variables.
# Copy to .env for local dev, or set these in your host's dashboard for prod.

# PostgreSQL connection string. Local dev example shown; use your managed
# Postgres URL in production (most hosts provide one).
DATABASE_URL="postgresql://user:pass@localhost:5432/meshwar?schema=public"

# Secret used to sign JWTs. MUST be a strong random value (>= 16 chars) in
# production — the server refuses to start otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Port the server listens on (hosts usually set this for you).
PORT=8080

# Comma-separated list of allowed dashboard origins for CORS. Default "*" is
# fine for local dev / the pilot; lock it to your dashboard URL before a public
# launch, e.g. "https://dashboard.elkaptin.app".
CORS_ORIGIN="*"

# Set to "production" on your live host. Enables the strong-secret check and the
# login / tracking rate limiters.
NODE_ENV="development"
